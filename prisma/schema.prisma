// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         String    @default("user")
  createdAt    DateTime  @default(now())
  sessions     Session[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("sessions")
}

// Stores M-Pesa SMS transactions forwarded from the Android SMS Forwarder app
model SmsTransaction {
  id           String   @id                  // Transaction ID parsed from SMS (e.g. QGH8912355)
  from         String                        // Raw sender (e.g. "MPESA")
  sender       String                        // Parsed payee/payer name
  message      String                        // Full raw SMS text
  amount       Float    @default(0)          // Transaction amount in KES
  type         String                        // "send" | "receive" | "balance"
  category     String                        // e.g. "Groceries", "Income / Transfer"
  balanceAfter Float    @default(0)          // M-Pesa balance after transaction
  dateStr      String                        // Human-readable date string
  receivedAt   DateTime @default(now())      // When webhook received this SMS

  @@index([type])
  @@index([receivedAt])
  @@map("sms_transactions")
}
